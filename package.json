{
  "name": "phasm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "db:migrate": "wrangler d1 migrations apply phasm-db --local",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "tsx --test tests/*.test.ts",
    "import:validate": "tsx scripts/import-locations.ts",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src worker shared scripts tests vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.13.7",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.40.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
